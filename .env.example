# Copy to .env and fill in. Vite exposes only VITE_* keys to the browser.
VITE_APP_NAME="Vighan Natural Care"
VITE_API_BASE_URL=/api            # real backend base URL; the mock adapter is used when VITE_USE_MOCK_API=true
VITE_USE_MOCK_API=true
VITE_WHATSAPP_NUMBER=91XXXXXXXXXX   # digits only, with country code
VITE_SUPPORT_PHONE=+91 XXXXX XXXXX
VITE_FSSAI_LICENCE=XXXXXXXXXXXXXX
VITE_FREE_SHIPPING_THRESHOLD=499
VITE_COD_FEE=29
